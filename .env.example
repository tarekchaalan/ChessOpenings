# Copy to .env.local and fill in. Without the Supabase values the app runs in
# guest-only mode (progress in the browser, no accounts or leaderboard).

# Browser client (Supabase dashboard → Connect)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server routes: /api/train, /api/progress, /api/account (never expose these)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Sign in with Lichess / Chess.com (docs/design/0009-oauth-sign-in.md).
# Lichess works with none of these; the client id is shown on its consent screen
# (defaults to this site's host).
LICHESS_CLIENT_ID=
# Chess.com: from the credentials it issues after approving the OAuth form.
# The public client id turns its buttons on; the server needs the endpoints too.
NEXT_PUBLIC_CHESSCOM_CLIENT_ID=
CHESSCOM_CLIENT_SECRET=
CHESSCOM_AUTHORIZE_URL=
CHESSCOM_TOKEN_URL=
# optional: CHESSCOM_SCOPE (default "openid profile"), CHESSCOM_ISSUER (checked against the ID token)

# scripts/seed-remote.ts only
SUPABASE_SERVICE_ROLE_KEY=

# `supabase config push` only: the sending-only Resend key used for auth SMTP
RESEND_API_KEY=
