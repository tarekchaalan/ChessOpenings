# Copy to .env.local and fill in. Without the Supabase values the app runs in
# guest-only mode (progress in the browser, no accounts or leaderboard).

# Browser client (Supabase dashboard → Connect)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server routes: /api/train, /api/progress, /api/account (never expose these)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# scripts/seed-remote.ts only
SUPABASE_SERVICE_ROLE_KEY=

# `supabase config push` only: the sending-only Resend key used for auth SMTP
RESEND_API_KEY=
