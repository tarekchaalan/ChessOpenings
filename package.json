{
  "name": "chess-openings-trainer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/openings/build.ts --allow-errors",
    "dev": "tsx scripts/openings/dev.ts",
    "dev:next": "next dev",
    "prebuild": "tsx scripts/openings/build.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && npm run openings:check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "openings:build": "tsx scripts/openings/build.ts",
    "openings:check": "tsx scripts/openings/check.ts",
    "corpus:build": "tsx scripts/openings/corpus.ts",
    "ingest": "tsx scripts/ingest.ts",
    "seed:remote": "tsx scripts/seed-remote.ts"
  },
  "dependencies": {
    "@supabase/server": "^1.2.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chokidar": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "fzstd": "^0.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
